#include <iostream>
#include <string>
#include<sstream>

template<typename T>
class Vector {
public:
    Vector()
    {
        resize(2);
    }
    void push(const T& element)
    {
        if (_size >= _capacity)
            resize(_capacity * 2);

        elements[_size++] = element;
        std::cout << "ok"<<std::endl;
    }
    void pop()
    {
        if (_size >= 0)
        {
            _size--;
            std::cout << elements[_size]<<std::endl;
            elements[_size] = NULL;
            _capacity = _size;
            resize(_capacity);
        }
        else
            std :: cout << "error"<<std::endl;
    }
    void at_i (size_t i)
    {
        std :: cout << elements[i]<<std::endl;
    }
    size_t size() const {return _size;}
    size_t capacity() const {return _capacity;}
    void clear()
    {
        delete[] elements;
        std:: cout << "ok"<<std::endl;
        resize(1);
    }
    void exit()
    {
        std:: cout << "bye"<<std::endl;
        std::exit(0);
    }
private:
    int n;
    T* elements = nullptr;
    size_t _capacity = 0;
    size_t _size = 0;
public:
    void resize(size_t newCapacity)
    {
        T* newMemory = new T[newCapacity];
        for (size_t i = 0; i <_size; i++)
            newMemory[i] = elements[i];
        delete[] elements;
        elements = newMemory;
        _capacity = newCapacity;
        if (_capacity < _size)
            _size = _capacity;
    };
};


