#include <iostream>
#include <string>
#include<sstream>


class Stack
{
    int *array_;
    int capacity_ ;
    int top_;
public:
    Stack(int capacity_ );

    void push(int x);
    void pop();
    void back();
    void size();
    void Clear();
    void Exit();
};

Stack::Stack(int capacity_)
{
    array_ = new int[capacity_];
    top_ = -1;
}


void Stack::push(int x)
{
    array_[++top_] = x;
}

void Stack::pop()
{
    if (top_ > -1)
    {
        std::cout<< array_[top_] << std::endl;
        array_[top_] = NULL;
        top_--;
    }
    else
        std::cout<< "error" << std::endl;
}

void Stack::back()
{
    if (top_ > -1)
        std::cout<< array_[top_] << std::endl;
    else
        std::cout<< "error" << std::endl;
}

void Stack::size()
{
    int stack_size = top_;
    std::cout<< ++stack_size << std::endl;
}

void Stack::Clear()
{
    if (top_ != -1)
        for (int i = 0; i <= top_; i++)
            array_[i] = NULL;
    top_ = -1;
}

void Stack::Exit()
{
    std::cout<< "bye" << std::endl;
    std::exit(0);
}
int main()
{
    Stack new_stack(200);
    std::string input, word, input1[10] ;

    while (1 == 1)
    {
        std::getline(std::cin, input);
        int i = 0;
        if  (input != "")
        {
            std::stringstream X(input);
            while (std::getline(X, word,' '))
                input1[i++] = word;
        }
        else
            input1[0] = '0';

        int n = 0;
        for (int i = 0; i< input.size(); i++)
            if (input[i] >= '0' && input[i]<= '9')
            {
                n *= 10;
                n += int(input[i]) - 48;
            }
        for (int i = 0; i< input.size(); i++)
            if (input[i] == '-')
                n = n * (-1);
        if (input1[0] == "push" && input1[1] != "" )
        {
            new_stack.push(n);
            std::cout<< "ok" <<std::endl;
        }
        else if (input1[0] == "pop")
            new_stack.pop();
        else if (input1[0] == "back")
            new_stack.back();
        else if (input1[0] == "size")
            new_stack.size();
        else if (input1[0] == "clear")
        {
            new_stack.Clear();
            std::cout<< "ok" << std::endl;
        }
        else if (input1[0] == "exit")
        {
            std::cout<< "bye" << std::endl;
            std::exit(0);
        }
        for (int i=0; i<10; i++)
            input1[i] = "";
    }
    return 0;
}
